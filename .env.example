# Koyeb Skill Environment Configuration Example
#
# KOYEB_API_KEY accepts either:
# 1. A literal Koyeb API personal access token:
#    KOYEB_API_KEY=replace-with-your-key
#
# 2. A 1Password CLI reference URI (resolved via `op read`):
#    KOYEB_API_KEY=op://your-vault/your-item/your-field
#
# The launcher scripts/koyeb_env.py injects the resolved token as KOYEB_TOKEN
# into the official Koyeb CLI execution environment.

KOYEB_API_KEY=replace-with-your-key

# Use the launcher's --koyeb-bin option when koyeb is not in PATH.
